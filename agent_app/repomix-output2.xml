package com.example.agent_app

import android.accessibilityservice.AccessibilityServiceInfo
import android.app.Activity
import android.app.NotificationChannel
import android.app.NotificationManager
import android.content.Context
import android.content.Intent
import android.media.projection.MediaProjectionManager
import android.os.Build
import android.os.Bundle
import android.provider.Settings
import android.util.Log
import android.view.accessibility.AccessibilityManager
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.embedding.engine.FlutterEngineCache
import io.flutter.plugin.common.MethodChannel

class MainActivity: FlutterActivity() {
    
    private val TAG = "MainActivity"
    private val CHANNEL = "com.example.agent_app/service"
    
    // ID Notification Channel (HARUS sama dengan ChatMonitorService)
    private val NOTIFICATION_CHANNEL_ID = "ChatMonitorServiceChannel"
    private val NOTIFICATION_CHANNEL_NAME = "Chat Monitor Service"
    
    // MediaProjection untuk screenshot
    private val SCREEN_CAPTURE_REQUEST_CODE = 1001
    private var mediaProjectionManager: MediaProjectionManager? = null
    
    // Callback untuk memberitahu Flutter hasil permission
    private var pendingResult: MethodChannel.Result? = null

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)

        Log.d(TAG, "🔧 Configuring Flutter Engine...")
        
        // Cache Flutter Engine agar bisa diakses dari Service
        FlutterEngineCache
            .getInstance()
            .put("main_flutter_engine", flutterEngine)
        Log.d(TAG, "✅ Flutter Engine cached with key 'main_flutter_engine'")
        
        // Buat notification channel saat app pertama kali dibuka
        createNotificationChannel()
        
        // Init MediaProjectionManager
        mediaProjectionManager = getSystemService(Context.MEDIA_PROJECTION_SERVICE) as MediaProjectionManager
        Log.d(TAG, "📷 MediaProjectionManager initialized")

        MethodChannel(
            flutterEngine.dartExecutor.binaryMessenger, 
            CHANNEL
        ).setMethodCallHandler { call, result ->

            when (call.method) {
                /**
                 * Membuka halaman Accessibility Settings
                 */
                "requestAccessibilityPermission" -> {
                    try {
                        Log.d(TAG, "📱 Opening Accessibility Settings...")
                        val intent = Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)
                        intent.flags = Intent.FLAG_ACTIVITY_NEW_TASK
                        startActivity(intent)
                        result.success(true) 
                    } catch (e: Exception) {
                        Log.e(TAG, "❌ Failed to open accessibility settings: ${e.message}")
                        result.error("ERROR", "Gagal membuka settings", e.message)
                    }
                }
                
                /**
                 * Cek apakah Accessibility Service sudah diaktifkan
                 */
                "isAccessibilityServiceEnabled" -> {
                    try {
                        val isEnabled = isAccessibilityServiceEnabled(
                            this, 
                            ChatMonitorService::class.java
                        )
                        Log.d(TAG, "🔍 Accessibility Service enabled: $isEnabled")
                        result.success(isEnabled)
                    } catch (e: Exception) {
                        Log.e(TAG, "❌ Error checking accessibility service: ${e.message}")
                        result.success(false)
                    }
                }
                
                /**
                 * Minta izin Screen Capture (MediaProjection)
                 */
                "requestScreenCapturePermission" -> {
                    try {
                        Log.d(TAG, "📸 Requesting screen capture permission...")
                        
                        // Simpan result untuk dipanggil di onActivityResult
                        pendingResult = result
                        
                        // Tampilkan dialog sistem "Izinkan merekam layar?"
                        val captureIntent = mediaProjectionManager?.createScreenCaptureIntent()
                        if (captureIntent != null) {
                            startActivityForResult(captureIntent, SCREEN_CAPTURE_REQUEST_CODE)
                        } else {
                            Log.e(TAG, "❌ MediaProjection intent is null")
                            result.error("ERROR", "MediaProjection tidak tersedia", null)
                            pendingResult = null
                        }
                    } catch (e: Exception) {
                        Log.e(TAG, "❌ Failed to request screen capture: ${e.message}")
                        result.error("ERROR", "Gagal membuka intent MediaProjection", e.message)
                        pendingResult = null
                    }
                }
                
                /**
                 * Memulai ChatMonitorService secara manual
                 */
                "startService" -> {
                    try {
                        Log.d(TAG, "🚀 Starting ChatMonitorService...")
                        val intent = Intent(this, ChatMonitorService::class.java)
                        
                        // Gunakan startForegroundService untuk Android 8.0+
                        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                            startForegroundService(intent)
                        } else {
                            startService(intent)
                        }
                        
                        result.success(true)
                        Log.d(TAG, "✅ Service start command sent")
                    } catch (e: Exception) {
                        Log.e(TAG, "❌ Failed to start service: ${e.message}")
                        result.error("ERROR", "Gagal start service", e.message)
                    }
                }
                
                /**
                 * Menghentikan ChatMonitorService
                 */
                "stopService" -> {
                    try {
                        Log.d(TAG, "🛑 Stopping ChatMonitorService...")
                        val intent = Intent(this, ChatMonitorService::class.java)
                        stopService(intent)
                        result.success(true)
                        Log.d(TAG, "✅ Service stop command sent")
                    } catch (e: Exception) {
                        Log.e(TAG, "❌ Failed to stop service: ${e.message}")
                        result.error("ERROR", "Gagal stop service", e.message)
                    }
                }

                else -> {
                    Log.w(TAG, "⚠️ Method not implemented: ${call.method}")
                    result.notImplemented()
                }
            }
        }
    }

    /**
     * Callback otomatis dipanggil setelah user klik "Allow" atau "Deny"
     * di dialog screen capture permission
     */
    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
        super.onActivityResult(requestCode, resultCode, data)
        
        if (requestCode == SCREEN_CAPTURE_REQUEST_CODE) {
            if (resultCode == Activity.RESULT_OK && data != null) {
                Log.i(TAG, "✅ Izin MediaProjection DIBERIKAN!")
                
                // Simpan "kunci" MediaProjection ke ScreenshotManager
                // agar bisa diakses oleh Service
                ScreenshotManager.mediaProjectionResultData = data
                
                // Restart service untuk mengambil "kunci" baru
                val intent = Intent(this, ChatMonitorService::class.java)
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                    startForegroundService(intent)
                } else {
                    startService(intent)
                }
                
                // Beritahu Flutter bahwa izin diberikan
                pendingResult?.success(true)
                
            } else {
                Log.e(TAG, "❌ Izin MediaProjection DITOLAK atau dibatalkan!")
                
                // Beritahu Flutter bahwa izin ditolak
                pendingResult?.success(false)
            }
            
            // Clear pending result
            pendingResult = null
        }
    }

    /**
     * Membuat Notification Channel untuk Foreground Service
     * Wajib dipanggil sebelum startForeground() di Android 8.0+
     */
    private fun createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            try {
                val channel = NotificationChannel(
                    NOTIFICATION_CHANNEL_ID,
                    NOTIFICATION_CHANNEL_NAME,
                    NotificationManager.IMPORTANCE_LOW
                ).apply {
                    description = "Notification untuk monitoring chat service yang berjalan di background"
                    setShowBadge(false)
                    enableLights(false)
                    enableVibration(false)
                    setSound(null, null)
                }
                
                val notificationManager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
                notificationManager.createNotificationChannel(channel)
                
                Log.d(TAG, "✅ Notification channel '$NOTIFICATION_CHANNEL_ID' created successfully")
            } catch (e: Exception) {
                Log.e(TAG, "❌ Failed to create notification channel: ${e.message}")
            }
        } else {
            Log.d(TAG, "ℹ️ Notification channel not needed for Android < 8.0")
        }
    }

    /**
     * Cek apakah Accessibility Service sudah diaktifkan oleh user
     */
    private fun isAccessibilityServiceEnabled(context: Context, service: Class<*>): Boolean {
        try {
            val accessibilityManager = context.getSystemService(Context.ACCESSIBILITY_SERVICE) as? AccessibilityManager
            
            if (accessibilityManager == null) {
                Log.e(TAG, "❌ AccessibilityManager is null")
                return false
            }
            
            val enabledServices = accessibilityManager.getEnabledAccessibilityServiceList(
                AccessibilityServiceInfo.FEEDBACK_ALL_MASK
            )

            for (enabledService in enabledServices) {
                val serviceInfo = enabledService.resolveInfo?.serviceInfo
                
                if (serviceInfo != null && 
                    serviceInfo.packageName == context.packageName && 
                    serviceInfo.name == service.name) {
                    Log.d(TAG, "✅ Service ${service.simpleName} is enabled")
                    return true
                }
            }
            
            Log.d(TAG, "⚠️ Service ${service.simpleName} is NOT enabled")
            return false
            
        } catch (e: Exception) {
            Log.e(TAG, "❌ Error checking accessibility service: ${e.message}")
            e.printStackTrace()
            return false
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        Log.d(TAG, "🎬 MainActivity onCreate")
    }

    override fun onResume() {
        super.onResume()
        Log.d(TAG, "▶️ MainActivity onResume")
        
        val isEnabled = isAccessibilityServiceEnabled(this, ChatMonitorService::class.java)
        Log.d(TAG, "📊 Current service status: ${if (isEnabled) "ENABLED" else "DISABLED"}")
    }

    override fun onDestroy() {
        super.onDestroy()
        Log.d(TAG, "💀 MainActivity onDestroy")
    }
}
