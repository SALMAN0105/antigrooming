import 'dart:async';
import 'dart:io';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:permission_handler/permission_handler.dart';
import 'package:uuid/uuid.dart';
import 'package:qr_flutter/qr_flutter.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:dio/dio.dart';
import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';
import 'api_config.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Agent AntiGrooming',
      theme: ThemeData(
        primarySwatch: Colors.blue,
        brightness: Brightness.dark,
        scaffoldBackgroundColor: const Color(0xFF0A0E21),
        fontFamily: 'Roboto',
      ),
      home: const HomePage(),
    );
  }
}

class HomePage extends StatefulWidget {
  const HomePage({super.key});

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage>
    with SingleTickerProviderStateMixin {
  static const platform = MethodChannel('com.example.agent_app/service');
  final Dio _dio = Dio();

  bool _isServiceEnabled = false;
  String _statusText = 'Belum Diaktifkan';
  bool _isLoading = false;
  String? _deviceToken;
  bool _isPaired = false;

  Timer? _pollingTimer;
  Timer? _syncTimer;
  late Database _localDb;

  // Permission status
  bool _hasNotificationPermission = false;
  bool _hasAccessibilityPermission = false;
  bool _hasScreenCapturePermission = false;

  late AnimationController _animationController;
  late Animation<double> _fadeAnimation;

  @override
  void initState() {
    super.initState();
    _initAnimation();
    _initLocalDatabase().then((_) {
      _initDeviceToken();
    });
    _setupMethodChannelListener();
    _checkServiceStatus();
    _checkNotificationPermission();
  }

  void _initAnimation() {
    _animationController = AnimationController(
      duration: const Duration(milliseconds: 800),
      vsync: this,
    );
    _fadeAnimation = Tween<double>(begin: 0.0, end: 1.0).animate(
      CurvedAnimation(parent: _animationController, curve: Curves.easeIn),
    );
    _animationController.forward();
  }

  Future<void> _initLocalDatabase() async {
    _localDb = await openDatabase(
      join(await getDatabasesPath(), 'antigrooming.db'),
      onCreate: (db, version) {
        return db.execute(
          'CREATE TABLE pending_incidents(id INTEGER PRIMARY KEY AUTOINCREMENT, text TEXT, appName TEXT, timestamp TEXT, screenshotPath TEXT)',
        );
      },
      version: 1,
    );
    _syncTimer = Timer.periodic(
      const Duration(seconds: 30),
      (timer) => _syncOfflineData(),
    );
  }

  Future<void> _initDeviceToken() async {
    final prefs = await SharedPreferences.getInstance();
    String? token = prefs.getString('device_token');
    bool pairedStatus = prefs.getBool('is_paired') ?? false;

    if (token == null) {
      token = const Uuid().v4();
      await prefs.setString('device_token', token);
    }

    setState(() {
      _deviceToken = token;
      _isPaired = pairedStatus;
    });

    if (!_isPaired) _startPolling();
  }

  void _startPolling() {
    _pollingTimer = Timer.periodic(const Duration(seconds: 5), (timer) async {
      if (_deviceToken == null) return;
      try {
        final response = await _dio.get(
          '${ApiConfig.baseUrl}/device/status/$_deviceToken',
        );
        if (response.data['status'] == 'paired') {
          timer.cancel();
          final prefs = await SharedPreferences.getInstance();
          await prefs.setBool('is_paired', true);
          setState(() => _isPaired = true);
        }
      } catch (e) {
        // Abaikan jika server offline saat polling
      }
    });
  }

  void _setupMethodChannelListener() {
    platform.setMethodCallHandler((call) async {
      if (call.method == 'uploadIncident') {
        await _handleIncidentPayload(call.arguments);
      }
    });
  }

  Future<void> _handleIncidentPayload(Map<dynamic, dynamic> data) async {
    try {
      await _sendToServer(data);
    } catch (e) {
      await _localDb.insert('pending_incidents', {
        'text': data['text'],
        'appName': data['appName'],
        'timestamp': data['timestamp'],
        'screenshotPath': data['screenshotPath'],
      });
    }
  }

  Future<void> _sendToServer(Map<dynamic, dynamic> incidentData) async {
    if (_deviceToken == null) return;
    FormData formData = FormData.fromMap({
      'device_token': _deviceToken,
      'detected_text': incidentData['text'],
      'app_name': incidentData['appName'],
      'risk_level': 'high',
      'incident_timestamp': incidentData['timestamp'],
      'pelaku_identitas':
          incidentData['pelaku_identitas'] ??
          'Tidak Diketahui', // <-- TAMBAHAN BARU
    });

    String? screenshotPath = incidentData['screenshotPath'];
    if (screenshotPath != null && File(screenshotPath).existsSync()) {
      formData.files.add(
        MapEntry(
          'screenshot',
          await MultipartFile.fromFile(
            screenshotPath,
            filename: screenshotPath.split('/').last,
          ),
        ),
      );
    }
    await _dio.post(ApiConfig.incidentsEndpoint, data: formData);
  }

  Future<void> _syncOfflineData() async {
    final List<Map<String, dynamic>> pendingData = await _localDb.query(
      'pending_incidents',
    );
    if (pendingData.isEmpty) return;

    for (var row in pendingData) {
      try {
        await _sendToServer(row);
        await _localDb.delete(
          'pending_incidents',
          where: 'id = ?',
          whereArgs: [row['id']],
        );
      } catch (e) {
        break;
      }
    }
  }

  Future<void> _checkNotificationPermission() async {
    final notif = await Permission.notification.status;
    setState(() => _hasNotificationPermission = notif.isGranted);
  }

  Future<void> _checkServiceStatus() async {
    bool isEnabled = false;
    try {
      isEnabled = await platform.invokeMethod('isAccessibilityServiceEnabled');
    } catch (e) {
      isEnabled = false;
    }

    setState(() {
      _isServiceEnabled = isEnabled;
      _hasAccessibilityPermission = isEnabled;
      _statusText = isEnabled ? 'Semua Aktif ✓' : 'Belum Diaktifkan';
    });

    if (isEnabled) {
      try {
        await platform.invokeMethod('startService');
      } catch (e) {}
    }
  }

  Future<void> _requestPermission() async {
    setState(() {
      _isLoading = true;
      _statusText = 'Memproses izin...';
    });

    try {
      var statusNotif = await Permission.notification.status;
      if (!statusNotif.isGranted) {
        statusNotif = await Permission.notification.request();
        if (!statusNotif.isGranted) {
          setState(() {
            _statusText = 'Izin Notifikasi Ditolak!';
            _isLoading = false;
          });
          return;
        }
      }
      setState(() => _hasNotificationPermission = true);

      await platform.invokeMethod('requestAccessibilityPermission');
      await Future.delayed(const Duration(seconds: 15));

      final isAccessibilityEnabled = await platform.invokeMethod(
        'isAccessibilityServiceEnabled',
      );
      setState(() => _hasAccessibilityPermission = isAccessibilityEnabled);

      if (!isAccessibilityEnabled) {
        setState(() {
          _statusText = 'Aksesibilitas belum diaktifkan';
          _isLoading = false;
        });
        return;
      }

      await platform.invokeMethod('requestScreenCapturePermission');
      await Future.delayed(const Duration(seconds: 5));
      await _checkServiceStatus();

      setState(() => _isLoading = false);

      if (_isServiceEnabled) {
        setState(() => _hasScreenCapturePermission = true);
      }
    } catch (e) {
      setState(() {
        _statusText = 'Error terjadi';
        _isLoading = false;
      });
    }
  }

  @override
  void dispose() {
    _pollingTimer?.cancel();
    _syncTimer?.cancel();
    _localDb.close();
    _animationController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Container(
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            colors: [Color(0xFF0A0E21), Color(0xFF1D1E33), Color(0xFF0A0E21)],
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
          ),
        ),
        child: SafeArea(
          child: FadeTransition(
            opacity: _fadeAnimation,
            child: SingleChildScrollView(
              physics: const BouncingScrollPhysics(),
              child: Padding(
                padding: const EdgeInsets.all(24.0),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    const SizedBox(height: 20),
                    _buildHeader(),
                    const SizedBox(height: 40),
                    _buildStatusCard(),
                    const SizedBox(height: 30),
                    _buildPermissionChecklist(),
                    const SizedBox(height: 30),
                    _buildMainButton(),
                    const SizedBox(height: 30),
                    _buildQrCodeSection(),
                  ],
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildQrCodeSection() {
    if (_deviceToken == null) return const SizedBox.shrink();
    if (_isPaired) {
      return Container(
        padding: const EdgeInsets.all(20),
        decoration: BoxDecoration(
          color: Colors.green.withOpacity(0.2),
          borderRadius: BorderRadius.circular(15),
        ),
        child: const Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(Icons.link, color: Colors.green),
            SizedBox(width: 10),
            Text(
              'Perangkat Terhubung ke Aplikasi Orang Tua',
              style: TextStyle(
                color: Colors.white,
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        ),
      );
    }
    return Container(
      padding: const EdgeInsets.all(20),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(20),
      ),
      child: Column(
        children: [
          const Text(
            'Scan QR ini di Aplikasi Orang Tua',
            style: TextStyle(
              fontSize: 16,
              fontWeight: FontWeight.bold,
              color: Colors.black87,
            ),
            textAlign: TextAlign.center,
          ),
          const SizedBox(height: 16),
          QrImageView(
            data: _deviceToken!,
            version: QrVersions.auto,
            size: 200.0,
            backgroundColor: Colors.white,
          ),
        ],
      ),
    );
  }

  Widget _buildHeader() {
    return Column(
      children: [
        Icon(
          Icons.shield,
          size: 60,
          color: _isServiceEnabled ? Colors.green : Colors.blue,
        ),
        const SizedBox(height: 20),
        const Text(
          'Agent AntiGrooming',
          style: TextStyle(
            fontSize: 28,
            fontWeight: FontWeight.bold,
            color: Colors.white,
          ),
        ),
      ],
    );
  }

  Widget _buildStatusCard() {
    return Container(
      padding: const EdgeInsets.all(24),
      decoration: BoxDecoration(
        color: const Color(0xFF1D1E33),
        borderRadius: BorderRadius.circular(20),
      ),
      child: Text(
        _statusText,
        style: const TextStyle(fontSize: 18, color: Colors.white),
        textAlign: TextAlign.center,
      ),
    );
  }

  Widget _buildPermissionChecklist() {
    return Column(
      children: [
        _buildPermissionItem(
          'Notifikasi',
          _hasNotificationPermission,
          Icons.notifications,
        ),
        _buildPermissionItem(
          'Aksesibilitas',
          _hasAccessibilityPermission,
          Icons.accessibility,
        ),
        _buildPermissionItem(
          'Rekam Layar',
          _hasScreenCapturePermission,
          Icons.screenshot,
        ),
      ],
    );
  }

  Widget _buildPermissionItem(String title, bool isGranted, IconData icon) {
    return Row(
      children: [
        Icon(icon, color: isGranted ? Colors.green : Colors.grey),
        const SizedBox(width: 12),
        Text(
          title,
          style: TextStyle(color: isGranted ? Colors.white : Colors.grey),
        ),
      ],
    );
  }

  Widget _buildMainButton() {
    return ElevatedButton(
      style: ElevatedButton.styleFrom(
        backgroundColor: _isServiceEnabled ? Colors.green : Colors.blue,
        padding: const EdgeInsets.symmetric(vertical: 18),
      ),
      onPressed: _isLoading
          ? null
          : (_isServiceEnabled ? _checkServiceStatus : _requestPermission),
      child: _isLoading
          ? const CircularProgressIndicator(color: Colors.white)
          : Text(_isServiceEnabled ? 'REFRESH STATUS' : 'AKTIFKAN LAYANAN'),
    );
  }
}
