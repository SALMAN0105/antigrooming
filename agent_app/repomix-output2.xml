package com.example.agent_app

import android.accessibilityservice.AccessibilityService
import android.accessibilityservice.AccessibilityServiceInfo
import android.app.Activity
import android.app.Notification
import android.app.PendingIntent
import android.content.Context
import android.content.Intent
import android.graphics.Bitmap
import android.graphics.PixelFormat
import android.hardware.display.DisplayManager
import android.hardware.display.VirtualDisplay
import android.media.ImageReader
import android.media.projection.MediaProjection
import android.media.projection.MediaProjectionManager
import android.os.Handler
import android.os.Looper
import android.util.DisplayMetrics
import android.util.Log
import android.view.WindowManager
import android.view.accessibility.AccessibilityEvent
import android.view.accessibility.AccessibilityNodeInfo
import androidx.core.app.NotificationCompat
import io.flutter.embedding.engine.FlutterEngineCache
import io.flutter.plugin.common.MethodChannel
import java.io.File
import java.io.FileOutputStream
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

class ChatMonitorService : AccessibilityService() {

    private val TAG = "ChatMonitorService"
    private val NOTIFICATION_CHANNEL_ID = "ChatMonitorServiceChannel"
    private val NOTIFICATION_ID = 1

    // Objek-objek untuk Screenshot
    private var mediaProjectionManager: MediaProjectionManager? = null
    private var mediaProjection: MediaProjection? = null
    private var virtualDisplay: VirtualDisplay? = null
    private var imageReader: ImageReader? = null
    private var windowManager: WindowManager? = null
    private var displayMetrics: DisplayMetrics? = null

    // Jembatan untuk "melempar" data ke Dart
    private var channel: MethodChannel? = null

    private val handler = Handler(Looper.getMainLooper())
    private var scanRunnable: Runnable? = null
    private val recentTexts = mutableSetOf<String>()
    
    // Fungsi "Pemburu Teks" (Rekursif)
    private fun traverseNodes(node: AccessibilityNodeInfo?, foundTexts: MutableList<String>) {
        if (node == null) return

        try {
            val className = node.className?.toString() ?: ""
            if (className == "android.widget.EditText") {
                return
            }

            if (className == "android.widget.TextView" && 
                node.text != null && 
                node.text.isNotBlank()) {
                
                val foundText = node.text.toString().trim()
                
                if (foundText.length > 1 && !recentTexts.contains(foundText)) {
                    foundTexts.add(foundText)
                }
            }

            for (i in 0 until node.childCount) {
                val childNode = node.getChild(i)
                if (childNode != null) {
                    traverseNodes(childNode, foundTexts)
                }
            }
        } catch (e: Exception) {
            Log.e(TAG, "Error saat traverse node: ${e.message}")
        }
    }

    // Fungsi onAccessibilityEvent (Di-update)
    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        if (event == null) return

        if (event.eventType == AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED) {
            
            val packageName = event.packageName?.toString() ?: ""
            if (!isMonitoredPackage(packageName)) return

            scanRunnable?.let { handler.removeCallbacks(it) }
            
            scanRunnable = Runnable {
                val rootNode = rootInActiveWindow ?: return@Runnable
                
                Log.d(TAG, "--- DEBOUNCE SELESAI: Memulai Scan ---")
                
                val allFoundTexts = mutableListOf<String>()
                traverseNodes(rootNode, allFoundTexts)
                rootNode.recycle() 

                if (allFoundTexts.isEmpty()) {
                    return@Runnable
                }

                val targetText = allFoundTexts.maxByOrNull { it.length }

                if (targetText != null && targetText.length > 2) {
                    Log.d(TAG, "=================================================")
                    Log.d(TAG, "TEKS TERPILIH (TERPANJANG)")
                    Log.d(TAG, "Aplikasi: $packageName")
                    Log.d(TAG, "Teks: $targetText")
                    Log.d(TAG, "Score:")
                    Log.d(TAG, "=================================================")
                    
                    recentTexts.add(targetText)
                    if (recentTexts.size > 50) {
                        recentTexts.remove(recentTexts.first())
                    }

                    // Ambil Screenshot dan kirim ke Flutter/Dart
                    takeScreenshotAndUpload(
                        text = targetText,
                        appName = mapPackageToAppName(packageName),
                        deviceToken = "TOKEN-TES-123"
                    )
                }
            }
            
            handler.postDelayed(scanRunnable!!, 1500)
        }
    }
    
    // Fungsi: Pemicu Screenshot
    private fun takeScreenshotAndUpload(text: String, appName: String, deviceToken: String, rootNode: AccessibilityNodeInfo, packageName: String) {
        val pelakuIdentitas = extractPelakuIdentity(rootNode, packageName)
        
        if (mediaProjection == null) {
            sendToFlutter(text, appName, deviceToken, null, pelakuIdentitas)
            return
        }

        Log.d(TAG, "📸 Memulai pengambilan screenshot...")

        val image = imageReader?.acquireLatestImage()
        if (image == null) {
            Log.e(TAG, "❌ Gagal ambil screenshot: imageReader 'acquireLatestImage' gagal.")
            sendToFlutter(text, appName, deviceToken, null)
            return
        }

        try {
            val planes = image.planes
            val buffer = planes[0].buffer
            val pixelStride = planes[0].pixelStride
            val rowStride = planes[0].rowStride
            val rowPadding = rowStride - pixelStride * displayMetrics!!.widthPixels

            val bitmap = Bitmap.createBitmap(
                displayMetrics!!.widthPixels + rowPadding / pixelStride,
                displayMetrics!!.heightPixels,
                Bitmap.Config.ARGB_8888
            )
            bitmap.copyPixelsFromBuffer(buffer)
            image.close()

            // Simpan bitmap ke file cache
            val file = saveBitmapToFile(bitmap)
        if (file != null) {
            sendToFlutter(text, appName, deviceToken, file.absolutePath, pelakuIdentitas)
        } else {
            sendToFlutter(text, appName, deviceToken, null, pelakuIdentitas)
        }
        } catch (e: Exception) {
            Log.e(TAG, "❌ Error saat memproses screenshot: ${e.message}")
            e.printStackTrace()
            sendToFlutter(text, appName, deviceToken, null)
        }
    }

    // Fungsi: Penyimpan Bitmap
   private fun saveBitmapToFile(bitmap: Bitmap): File? {
        val cacheDir = applicationContext.cacheDir 
        val timestamp = System.currentTimeMillis()
        // 1. UBAH EKSTENSI MENJADI JPG
        val file = File(cacheDir, "ss_$timestamp.jpg") 
        
        return try {
            val fos = FileOutputStream(file)
            // 2. UBAH KOMPRESI KE JPEG DENGAN KUALITAS 70%
            bitmap.compress(Bitmap.CompressFormat.JPEG, 70, fos) 
            fos.flush()
            fos.close()
            file
        } catch (e: Exception) {
            Log.e(TAG, "Gagal simpan file screenshot: ${e.message}")
            e.printStackTrace()
            null
        }
    }

    // Fungsi: Kirim data ke FLUTTER/DART
    private fun sendToFlutter(text: String, appName: String, deviceToken: String, screenshotPath: String?, pelakuIdentitas: String) {
        if (channel == null) return
        val timestamp = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.US).format(Date())
        
        val data = mapOf(
            "text" to text,
            "appName" to appName,
            "deviceToken" to deviceToken,
            "timestamp" to timestamp,
            "screenshotPath" to screenshotPath,
            "pelaku_identitas" to pelakuIdentitas // <-- DATA BARU
        )
        handler.post { channel?.invokeMethod("uploadIncident", data) }
    }

    // Helper: Cek paket yang dimonitor
    private fun isMonitoredPackage(packageName: String): Boolean {
        return packageName in setOf(
            "com.whatsapp", 
            "com.whatsapp.w4b", 
            "com.instagram.android", 
            "com.facebook.orca"
        )
    }
    
    // Helper: Map package ke app name
    private fun mapPackageToAppName(packageName: String): String {
        return when (packageName) {
            "com.whatsapp" -> "whatsapp"
            "com.whatsapp.w4b" -> "whatsapp_business"
            "com.instagram.android" -> "instagram"
            "com.facebook.orca" -> "messenger"
            else -> packageName
        }
    }

    override fun onInterrupt() {
        Log.e(TAG, "⚠️ Servis di-interrupt!")
        scanRunnable?.let { handler.removeCallbacks(it) }
        recentTexts.clear()
        stopScreenCapture()
    }

    // Fungsi: Menghentikan Screenshot
    private fun stopScreenCapture() {
        virtualDisplay?.release()
        imageReader?.close()
        mediaProjection?.stop()
        mediaProjection = null
        Log.i(TAG, "Screen capture dihentikan.")
    }

    override fun onServiceConnected() {
        super.onServiceConnected()
        Log.i(TAG, "🔧 onServiceConnected dipanggil...")

        // Inisialisasi Jembatan Flutter
        val flutterEngine = FlutterEngineCache.getInstance().get("main_flutter_engine")
        if (flutterEngine != null) {
            channel = MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "com.example.agent_app/service")
            Log.i(TAG, "✅ Jembatan MethodChannel berhasil terhubung.")
        } else {
            Log.e(TAG, "❌ Gagal terhubung ke Flutter Engine! Pastikan 'main_flutter_engine' ada.")
        }
        
        // Inisialisasi Screenshot Manager
        windowManager = getSystemService(Context.WINDOW_SERVICE) as WindowManager
        displayMetrics = DisplayMetrics()
        windowManager?.defaultDisplay?.getMetrics(displayMetrics)
        
        mediaProjectionManager = getSystemService(Context.MEDIA_PROJECTION_SERVICE) as MediaProjectionManager
        
        // Ambil resultData dari ScreenshotManager (singleton object)
        val resultData = ScreenshotManager.mediaProjectionResultData
        if (resultData != null) {
            try {
                mediaProjection = mediaProjectionManager?.getMediaProjection(Activity.RESULT_OK, resultData)
                
                imageReader = ImageReader.newInstance(
                    displayMetrics!!.widthPixels,
                    displayMetrics!!.heightPixels,
                    PixelFormat.RGBA_8888, 2
                )
                
                virtualDisplay = mediaProjection?.createVirtualDisplay(
                    "ScreenCapture",
                    displayMetrics!!.widthPixels,
                    displayMetrics!!.heightPixels,
                    displayMetrics!!.densityDpi,
                    DisplayManager.VIRTUAL_DISPLAY_FLAG_AUTO_MIRROR,
                    imageReader?.surface, null, null
                )
                Log.i(TAG, "✅ MediaProjection (Screenshot) berhasil di-setup.")
            } catch (e: Exception) {
                Log.e(TAG, "❌ Gagal memulai MediaProjection: ${e.message}")
            }
        } else {
            Log.e(TAG, "❌ Gagal setup screenshot: Izin MediaProjection (resultData) null.")
        }

        // Setup Foreground Service
        val notificationIntent = Intent(this, MainActivity::class.java)
        val pendingIntent = PendingIntent.getActivity(
            this, 0, notificationIntent, PendingIntent.FLAG_IMMUTABLE
        )
        val notification: Notification = NotificationCompat.Builder(this, NOTIFICATION_CHANNEL_ID)
            .setContentTitle("Layanan AntiGrooming Aktif")
            .setContentText("Aplikasi ini sedang memonitor chat untuk perlindungan.")
            .setSmallIcon(android.R.drawable.ic_dialog_info)
            .setContentIntent(pendingIntent)
            .setOngoing(true)
            .build()
        startForeground(NOTIFICATION_ID, notification)
        Log.i(TAG, "✅ Foreground service dimulai.")
        
        // Setup Info Aksesibilitas
        val info = AccessibilityServiceInfo().apply {
            eventTypes = AccessibilityEvent.TYPE_VIEW_TEXT_CHANGED or
                         AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED or
                         AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED
            feedbackType = AccessibilityServiceInfo.FEEDBACK_GENERIC
            packageNames = arrayOf(
                "com.whatsapp", "com.whatsapp.w4b",
                "com.instagram.android", "com.facebook.orca"
            )
            notificationTimeout = 100
            flags = AccessibilityServiceInfo.FLAG_RETRIEVE_INTERACTIVE_WINDOWS
        }
        this.serviceInfo = info
        Log.i(TAG, "✅ Layanan AntiGrooming Terhubung & Siap Memonitor!")
    }

    override fun onDestroy() {
        super.onDestroy()
        scanRunnable?.let { handler.removeCallbacks(it) }
        recentTexts.clear()
        stopScreenCapture()
        Log.i(TAG, "🛑 Layanan AntiGrooming Dihentikan")
    }

    private fun extractPelakuIdentity(rootNode: AccessibilityNodeInfo?, packageName: String): String {
        if (rootNode == null) return "Tidak Diketahui"

        try {
            // Logika Instagram: Username biasanya ada di Title Bar
            if (packageName.contains("instagram")) {
                val nodes = rootNode.findAccessibilityNodeInfosByViewId("com.instagram.android:id/action_bar_title")
                if (nodes.isNotEmpty() && nodes[0].text != null) {
                    return "@" + nodes[0].text.toString()
                }
            }
            
            // Logika WhatsApp: Nama/Nomor ada di conversation_contact_name
            if (packageName.contains("whatsapp")) {
                val nodes = rootNode.findAccessibilityNodeInfosByViewId("com.whatsapp:id/conversation_contact_name")
                if (nodes.isNotEmpty() && nodes[0].text != null) {
                    return nodes[0].text.toString()
                }
            }
        } catch (e: Exception) {
            Log.e(TAG, "Gagal ekstrak identitas: \${e.message}")
        }
        return "Tidak Diketahui"
    }
}
