import json
import re
import numpy as np
import mysql.connector
from datetime import datetime
from flask import Flask, request, jsonify
from tensorflow.keras.models import load_model
from tensorflow.keras.preprocessing.text import tokenizer_from_json
from tensorflow.keras.preprocessing.sequence import pad_sequences

print("--- Memulai API Server ---")

# Configure database
DB_CONFIG = {
    'host': '127.0.0.1',
    'user': 'root',
    'password': '',
    'database': 'db_ai_antigrooming'  # PERBAIKAN: Ganti strip dengan underscore
}

# Menentukan score grooming
DETECTION_THRESHOLD = 0.8
MAX_LEN = 50

# --- 1. Load Artefak AI ---
print("Memuat model AI (model.keras)...")
try:
    model = load_model('model.keras')
    print("Memuat kamus (tokenizer.json)...")
    with open('tokenizer.json') as f:
        data = f.read()
        tokenizer = tokenizer_from_json(data)
    print("✅ Model dan kamus berhasil dimuat ke memori.")
except Exception as e:
    print(f"❌ FATAL ERROR: Gagal memuat model atau tokenizer: {e}")
    exit()

# --- 2. Inisialisasi Flask API ---
app = Flask(__name__)

# --- 3. Fungsi Helper (Pembersih & Prediksi) ---
def clean_text(text):
    """Membersihkan teks dari karakter khusus"""
    text = str(text).lower()
    text = re.sub(r'[^a-zA-Z0-9\s]', '', text)
    return text

def predict_text(text):
    """Memprediksi score grooming dari teks"""
    cleaned_text = clean_text(text)
    sequences = tokenizer.texts_to_sequences([cleaned_text])
    padded = pad_sequences(sequences, maxlen=MAX_LEN, truncating='post', padding='post')
    score = model.predict(padded, verbose=0)[0][0]  # PERBAIKAN: Tambah verbose=0
    return float(score)

# --- 4. Fungsi Helper (Database) ---
def map_risk_level(score):
    """Mapping score ke level risiko"""
    if score > 0.95: return 'critical'
    if score > 0.8: return 'high'
    if score > 0.6: return 'medium'
    return 'low'

def get_db_connection():
    """Membuat koneksi ke database"""
    try:
        conn = mysql.connector.connect(**DB_CONFIG)
        return conn
    except mysql.connector.Error as err:
        print(f"❌ Error koneksi DB: {err}")
        return None

def get_device_id(device_token):
    """Mendapatkan device_id dari token"""
    conn = get_db_connection()
    if conn is None: 
        return None
    
    cursor = conn.cursor()
    try:
        cursor.execute("SELECT id FROM devices WHERE device_token = %s", (device_token,))
        result = cursor.fetchone()
        return result[0] if result else None
    except Exception as e:
        print(f"❌ Error saat query device_id: {e}")
        return None
    finally:
        cursor.close()
        conn.close()

def save_incident_to_db(device_id, text, app_name, risk_level, timestamp, screenshot_path):
    """Menyimpan data insiden ke tabel 'incidents'"""
    conn = get_db_connection()
    if conn is None: 
        return False

    cursor = conn.cursor()
    now = datetime.now()
    
    # PERBAIKAN: Handle screenshot_path yang None
    if screenshot_path and screenshot_path.strip():
        screenshot_value = screenshot_path
    else:
        screenshot_value = None

    query = """
    INSERT INTO incidents 
    (device_id, incident_timestamp, detected_text, app_name, risk_level, screenshot_path, created_at, updated_at) 
    VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
    """
    values = (
        device_id,
        timestamp,
        text,
        app_name,
        risk_level,
        screenshot_value,  # PERBAIKAN: Bisa NULL
        now,               # created_at
        now                # updated_at
    )
    
    try:
        cursor.execute(query, values)
        conn.commit()
        print(f"✅ Sukses: Insiden '{text[:50]}...' disimpan ke DB.")
        return True
    except Exception as e:
        conn.rollback()
        print(f"❌ Error saat INSERT ke 'incidents': {e}")
        return False
    finally:
        cursor.close()
        conn.close()

# --- 5. Endpoint API Utama ---
@app.route('/analyze', methods=['POST'])
def analyze_text():
    """Endpoint utama untuk analisis teks grooming"""
    
    # Ambil data dari request
    data = request.json
    
    # Validasi data wajib
    if not data:
        return jsonify({'error': 'Request body kosong'}), 400
    
    required_fields = ['text', 'device_token', 'app_name']
    missing_fields = [field for field in required_fields if field not in data]
    
    if missing_fields:
        return jsonify({
            'error': f'Data tidak lengkap. Field yang hilang: {", ".join(missing_fields)}'
        }), 400
    
    # Ekstrak data
    text_to_analyze = data['text']
    device_token = data['device_token']
    app_name = data['app_name']
    screenshot_path = data.get('screenshot_path', None)
    incident_timestamp = data.get('timestamp', datetime.now().isoformat())
    
    # Validasi teks tidak kosong
    if not text_to_analyze or not text_to_analyze.strip():
        return jsonify({'error': 'Teks tidak boleh kosong'}), 400
    
    print(f"\n{'='*60}")
    print(f"📥 Menerima request:")
    print(f"   Teks: '{text_to_analyze[:100]}...'")
    print(f"   App: {app_name}")
    print(f"   Token: {device_token}")
    print(f"   Screenshot: {'Ada' if screenshot_path else 'Tidak ada'}")
    print(f"{'='*60}")
    
    # Prediksi dengan AI
    try:
        score = predict_text(text_to_analyze)
        print(f"🤖 Skor AI: {score:.4f}")
    except Exception as e:
        print(f"❌ Error saat prediksi: {e}")
        return jsonify({'error': 'Gagal melakukan prediksi AI'}), 500
    
    incident_saved = False
    
    # Jika terdeteksi berbahaya
    if score >= DETECTION_THRESHOLD:
        print(f"⚠️ DETEKSI: Teks terdeteksi berbahaya! (Score: {score:.4f})")
        
        device_id = get_device_id(device_token)
        
        if device_id:
            risk_level = map_risk_level(score)
            print(f"📊 Risk Level: {risk_level.upper()}")
            
            incident_saved = save_incident_to_db(
                device_id,
                text_to_analyze,
                app_name,
                risk_level,
                incident_timestamp,
                screenshot_path
            )
        else:
            print(f"❌ Gagal simpan: Device token '{device_token}' tidak terdaftar di database.")
    else:
        print(f"✅ DETEKSI: Teks aman. (Score: {score:.4f})")

    # Response
    response = {
        'status': 'success',
        'input_text': text_to_analyze,
        'score': score,
        'detected': (score >= DETECTION_THRESHOLD),
        'incident_saved_to_db': incident_saved,
        'risk_level': map_risk_level(score) if score >= DETECTION_THRESHOLD else 'safe'
    }
    
    print(f"📤 Response: {response}")
    return jsonify(response)

# --- 6. Endpoint Health Check ---
@app.route('/health', methods=['GET'])
def health_check():
    """Endpoint untuk cek status server"""
    try:
        conn = get_db_connection()
        db_status = "connected" if conn else "disconnected"
        if conn:
            conn.close()
        
        return jsonify({
            'status': 'ok',
            'database': db_status,
            'model': 'loaded',
            'timestamp': datetime.now().isoformat()
        })
    except Exception as e:
        return jsonify({
            'status': 'error',
            'error': str(e)
        }), 500

# --- 7. Error Handlers ---
@app.errorhandler(404)
def not_found(error):
    return jsonify({'error': 'Endpoint tidak ditemukan'}), 404

@app.errorhandler(500)
def internal_error(error):
    return jsonify({'error': 'Internal server error'}), 500

# --- 8. Jalankan Server ---
if __name__ == '__main__':
    print("\n" + "="*60)
    print("🚀 Server Flask siap berjalan!")
    print("📍 Endpoint tersedia:")
    print("   POST /analyze  - Analisis teks grooming")
    print("   GET  /health   - Health check")
    print("="*60 + "\n")
    
    app.run(debug=True, host='0.0.0.0', port=5000)
</file>

