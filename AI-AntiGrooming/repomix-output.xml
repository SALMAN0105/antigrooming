<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\Child;
use App\Models\Device;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;

class PairingController extends Controller
{
    public function pairDevice(Request $request)
    {
        $validated = $request->validate([
            'child_name'   => 'required|string|max:255',
            'device_token' => 'required|string|max:255|unique:devices,device_token', 
        ]);

        DB::beginTransaction();
        
        try {
            // Buat entitas Child yang terikat dengan Parent (User) yang sedang login
            $child = Child::create([
                'user_id' => $request->user()->id,
                'nama'    => $validated['child_name'],
            ]);

            // Ikat UUID QR Code ke entitas Child
            $device = Device::create([
                'child_id'     => $child->id,
                'device_token' => $validated['device_token'],
            ]);

            DB::commit();

            return response()->json([
                'status'  => 'success',
                'message' => 'Perangkat anak berhasil dihubungkan.',
                'data'    => [
                    'child_id'  => $child->id,
                    'device_id' => $device->id
                ]
            ], 201);

        } catch (\Exception $e) {
            DB::rollBack();
            Log::error('Pairing failed: ' . $e->getMessage());
            
            return response()->json([
                'status'  => 'error',
                'message' => 'Terjadi kesalahan sistem saat melakukan pairing.'
            ], 500);
        }
    }
    // Tambahkan di dalam PairingController
    public function checkStatus($token)
    {
        // O(1) Lookup menggunakan index
        $isPaired = Device::query()->where('device_token', $token)->exists();
        
        return response()->json([
            'status' => $isPaired ? 'paired' : 'waiting'
        ]);
    }
}
