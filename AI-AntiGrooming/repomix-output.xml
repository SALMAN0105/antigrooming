<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\Incident;
use App\Models\Device;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Facades\Log;
use Kreait\Firebase\Factory;
use Kreait\Firebase\Messaging\CloudMessage;
use Kreait\Firebase\Messaging\Notification;

class IncidentController extends Controller
{
    /**
     * Endpoint untuk HP Orang Tua mengambil daftar insiden
     */
    public function index(Request $request)
    {
        $user = $request->user();
        
        // Ekstrak ID device milik anak-anak dari user ini secara O(1)
        $deviceIds = $user->devices()->pluck('devices.id');

        // Ambil insiden dengan Eager Loading (mencegah N+1 Query Problem) dan Linter Fix
        $incidents = Incident::query()->whereIn('device_id', $deviceIds->toArray(), 'and', false)
                            ->with('device.child')
                            ->latest('incident_timestamp')
                            ->paginate(20);

        return response()->json([
            'status' => 'success',
            'data'   => $incidents
        ]);
    }

    /**
     * Endpoint untuk HP Anak mengirim bukti grooming (Dipanggil jika AI menyatakan bahaya)
     */
    public function store(Request $request)
    {
        $request->validate([
            'device_token'       => 'required|exists:devices,device_token',
            'detected_text'      => 'required|string',
            'app_name'           => 'required|string',
            'risk_level'         => 'required|in:low,medium,high,critical',
            'incident_timestamp' => 'required|date',
            'pelaku_identitas'   => 'nullable|string', // Menerima Nomor WA/Username IG
            'screenshot'         => 'nullable|image|mimes:jpeg,png,jpg|max:5120',
        ]);

        try {
            $device = Device::query()->with('child.user')->where('device_token', $request->device_token)->firstOrFail();
            $screenshotPath = null;

            if ($request->hasFile('screenshot')) {
                $file = $request->file('screenshot');
                $filename = time() . '_' . uniqid() . '.' . $file->getClientOriginalExtension();
                $screenshotPath = $file->storeAs('incidents', $filename, 'public');
            }

            $incident = Incident::create([
                'device_id'          => $device->id,
                'incident_timestamp' => $request->incident_timestamp,
                'detected_text'      => $request->detected_text,
                'app_name'           => $request->app_name,
                'risk_level'         => $request->risk_level,
                'pelaku_identitas'   => $request->pelaku_identitas ?? 'Tidak Diketahui',
                'screenshot_path'    => $screenshotPath ? '/storage/' . $screenshotPath : null,
            ]);

            // Eksekusi Push Notification ke HP Orang Tua secara Real-Time
            $parentUser = $device->child->user;
            if ($parentUser && $parentUser->fcm_token) {
                $this->sendFcmNotification(
                    $parentUser->fcm_token, 
                    $device->child->nama, 
                    $request->app_name, 
                    $incident->pelaku_identitas
                );
            }

            return response()->json([
                'status'  => 'success', 
                'message' => 'Insiden dicatat dan Notifikasi terkirim.'
            ], 201);

        } catch (\Exception $e) {
            Log::error('Incident failed: ' . $e->getMessage());
            return response()->json([
                'status'  => 'error', 
                'message' => 'Gagal memproses sistem.'
            ], 500);
        }
    }

    /**
     * Fungsi Privat Terisolasi untuk mengirim Payload ke Firebase Google
     */
    private function sendFcmNotification($fcmToken, $childName, $appName, $pelaku)
    {
        try {
            // PASTIKAN: Anda harus menaruh file firebase_credentials.json di dalam folder storage/app/
            $factory = (new Factory)->withServiceAccount(storage_path('app/firebase_credentials.json'));
            $messaging = $factory->createMessaging();

            $title = "⚠️ Bahaya pada perangkat $childName!";
            $body = "Terdeteksi obrolan grooming dengan $pelaku di aplikasi $appName.";

            $message = CloudMessage::withTarget('token', $fcmToken)
                ->withNotification(Notification::create($title, $body));

            $messaging->send($message);
        } catch (\Exception $e) {
            Log::error('FCM Error: ' . $e->getMessage());
        }
    }
}
