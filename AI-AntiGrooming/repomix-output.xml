        </div>
    </nav>

    <div class="py-12">
        <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
            <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg">
                <div class="p-6 text-gray-900">
                    <h2 class="text-2xl font-bold text-gray-800 mb-6">Peringatan Terdeteksi</h2>
                    <div id="incidents-list" class="space-y-4"></div>
                    <div id="pagination-links" class="mt-6 text-center"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const initialData = @json($incidents);

        document.addEventListener('DOMContentLoaded', function() {
            const incidentsList = document.getElementById('incidents-list');
            const paginationLinks = document.getElementById('pagination-links');

            function formatDate(dateString) {
                const options = { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };
                return new Date(dateString).toLocaleDateString('id-ID', options);
            }
            
            function getRiskStyles(level) {
                switch (level) {
                    case 'critical': return 'border-red-500 text-red-700';
                    case 'high': return 'border-orange-500 text-orange-700';
                    case 'medium': return 'border-yellow-500 text-yellow-700';
                    default: return 'border-gray-400 text-gray-600';
                }
            }

            function renderIncidents(incidents) {
                incidentsList.innerHTML = '';
                if (incidents.length === 0) {
                    incidentsList.innerHTML = `<p class="text-gray-500">Tidak ada peringatan ditemukan.</p>`;
                    return;
                }
                incidents.forEach(incident => {
                    const riskStyles = getRiskStyles(incident.risk_level);
                    const card = `
                        <div class="bg-white p-4 rounded-lg shadow ${riskStyles}" style="border-left-width: 4px;">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-sm font-semibold text-gray-500">Aplikasi: ${escapeHTML(incident.app_name)}</span>
                                <span class="text-sm text-gray-500">${formatDate(incident.incident_timestamp)}</span>
                            </div>
                            <p class="text-gray-800 text-base">"${escapeHTML(incident.detected_text)}"</p>
                            <div class="mt-3 text-xs text-gray-500">
                                <span>Anak: ${incident.device.child.nama}</span> |
                                <span>Level: <span class="font-bold ${riskStyles}">${escapeHTML(incident.risk_level)}</span></span>
                            </div>
                        </div>
                    `;
                    incidentsList.innerHTML += card;
                });
            }

            function renderPagination(data) {
                paginationLinks.innerHTML = '';
                data.links.forEach(link => {
                    if (link.url) {
                        const button = document.createElement('button');
                        button.innerHTML = link.label.replace('&laquo; Previous', 'Sebelumnya').replace('Next &raquo;', 'Berikutnya');
                        button.className = `px-3 py-1 mx-1 rounded ${link.active ? 'bg-blue-500 text-white' : 'bg-white text-blue-500'} ${link.url === null ? 'opacity-50 cursor-not-allowed' : 'hover:bg-blue-100 border'}`;
                        if (link.url) {
                            const url = new URL(link.url);
                            const page = url.searchParams.get('page');
                            button.onclick = (e) => {
                                e.preventDefault();
                                fetchIncidents(page);
                            };
                        }
                        paginationLinks.appendChild(button);
                    }
                });
            }

            async function fetchIncidents(page) {
                const url = `{{ route('dashboard.fetch') }}?page=${page}`;
                try {
                    const response = await fetch(url, { headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
                    const data = await response.json();
                    renderIncidents(data.data);
                    renderPagination(data);
                    window.scrollTo(0, 0);
                } catch (error) { console.error('Gagal fetch paginasi:', error); }
            }
            
            function escapeHTML(str) {
                if (!str) return '';
                return str.replace(/[&<>"']/g, m => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'}[m]));
            }

            renderIncidents(initialData.data);
            renderPagination(initialData);
        });
    </script>
</body>
</html>
</file>

