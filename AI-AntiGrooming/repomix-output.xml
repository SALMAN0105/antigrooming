<file path="app/Http/Controllers/DashboardController.php">
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use App\Models\Incident;

class DashboardController extends Controller
{
    public function index()
    {
        $user = Auth::user();
        $deviceIds = $user->devices()->pluck('devices.id');

        $incidents = Incident::whereIn('device_id', $deviceIds)
                            ->with('device.child')
                            ->latest('incident_timestamp')
                            ->paginate(20);

        return view('dashboard', ['incidents' => $incidents]);
    }

    public function fetchIncidents(Request $request)
    {
        $user = Auth::user();
        $deviceIds = $user->devices()->pluck('devices.id');

        $incidents = Incident::whereIn('device_id', $deviceIds)
                            ->with('device.child')
                            ->latest('incident_timestamp')
                            ->paginate(20);

        return response()->json($incidents);
    }
}
